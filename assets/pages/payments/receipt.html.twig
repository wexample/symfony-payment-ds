{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}
{#- A page under another: the way back to it, its actions beside, on top. -#}
{%- set page_trail = 'back' -%}
{#- Under the payment it is the receipt of, not beside it. -#}
{%- do breadcrumb_append_route('payments_index') -%}
{%- do breadcrumb_append_route('payments_show', { id: payment.id }, payment.description ?: ('WexampleSymfonyPaymentDsBundle.common.payment::no_description' | trans)) -%}

{#- What was paid, kept: the payment as a document, printed by the browser. -#}
{%- block page_body -%}
    <section class="block block--card block--padded">
        <h2>{{ '@page::heading' | trans({ '%reference%': payment.id }) }}</h2>
        {%- include '@WexampleSymfonyPaymentDsBundle/partials/payment-properties.html.twig' -%}
        {%- if payment.refunds|length -%}
            <h3>{{ '@page::refunds' | trans }}</h3>
            {%- include '@WexampleSymfonyPaymentDsBundle/partials/payment-refunds.html.twig' -%}
        {%- endif -%}
    </section>
{%- endblock -%}
