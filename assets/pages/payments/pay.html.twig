{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- What is paid, how much, and how: the method chosen, the browser goes on
    to the provider's page or to the page waiting for the outcome. -#}
{%- block page_body -%}
    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/shopping-bag') }}</span>
            <span class="block--title-label">{{ payable.payableDescription ?: ('WexampleSymfonyPaymentDsBundle.common.payment::no_description' | trans) }}</span>
            <span class="block--title-trailing">{{ payable.payableAmount|price(payable.payableCurrencyCode, app.request.locale) }}</span>
        </div>
        <div class="block--body">
            {{ form_load(render_pass, payment_method_form, '@WexampleSymfonyPaymentDsBundle/forms/payment_method_form.html.twig') }}
        </div>
    </section>
{%- endblock -%}
