{
  "name": "wexample/symfony-payment-ds",
  "version": "3.0.4",
  "type": "library",
  "license": "MIT",
  "description": "The interface of symfony-payment: the payment step, the return page, the payer's payments and their administration",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyPaymentDs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyPaymentDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=18.0.0",
    "wexample/symfony-loader": ">=25.0.0",
    "wexample/symfony-design-system": ">=39.0.0",
    "wexample/symfony-api": ">=14.0.0",
    "wexample/symfony-forms": ">=14.0.0",
    "wexample/symfony-money": ">=7.0.0",
    "wexample/symfony-payment": ">=4.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}